type SduiTemplate {
    id: ID!
    name: String!
    json: String!
    version: String
    createdAt: String
    updatedAt: String
}

scalar JSON

type Transaction {
    id: ID!
    description: String!
    amount: String!
    type: String!
    date: String!
}

type Query {
    templates: [SduiTemplate!]!
    template(id: ID!): SduiTemplate
    templatesFiltered(filter: String, sort: String): [SduiTemplate!]!
    # Generic raw JSON passthrough (still validated, not arbitrary SQL)
    rawQuery(query: String!, variables: JSON): JSON
    recentTransactions: [Transaction!]!
}

type Mutation {
    saveTemplate(name: String!, json: String!): SduiTemplate!
    updateTemplate(id: ID!, name: String, json: String): SduiTemplate!
    deleteTemplate(id: ID!): Boolean!
}
